# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
FRONTEND_URL="http://localhost:3001"

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:password@localhost:5432/scriptverse"

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET="<generate-a-random-32-byte-hex-string>"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="<generate-a-random-32-byte-hex-string>"
JWT_REFRESH_EXPIRES_IN="7d"

# ── Seed passwords (required — must be set before running prisma db seed) ─────
SEED_ADMIN_PASSWORD="<set-a-strong-password>"
SEED_FORMATEUR_PASSWORD="<set-a-strong-password>"
SEED_APPRENANT_PASSWORD="<set-a-strong-password>"
