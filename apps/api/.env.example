# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
FRONTEND_URL="http://localhost:3001"

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:password@localhost:5432/scriptverse"

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_REFRESH_EXPIRES_IN="7d"

# ── Seed passwords (optional — defaults used when absent) ────────────────────
SEED_ADMIN_PASSWORD="Admin1234!"
SEED_FORMATEUR_PASSWORD="Formateur1234!"
SEED_APPRENANT_PASSWORD="Apprenant1234!"
